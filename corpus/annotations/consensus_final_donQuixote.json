[
  {
    "text": "WHEN HE LEFT THE INN",
    "start_ind": 43,
    "end_ind": 63
  },
  {
    "text": "Don Quixote quitted the inn",
    "start_ind": 119,
    "end_ind": 146
  },
  {
    "text": "he determined to go home",
    "start_ind": 408,
    "end_ind": 432
  },
  {
    "text": "stepped out so briskly",
    "start_ind": 757,
    "end_ind": 779
  },
  {
    "text": "He had not gone far",
    "start_ind": 823,
    "end_ind": 842
  },
  {
    "text": "He had gone but a few paces into\nthe wood",
    "start_ind": 1355,
    "end_ind": 1396
  },
  {
    "text": "let Andres\ncome home with me",
    "start_ind": 4052,
    "end_ind": 4080
  },
  {
    "text": "I go with him",
    "start_ind": 4123,
    "end_ind": 4136
  },
  {
    "text": "come along with me",
    "start_ind": 5013,
    "end_ind": 5031
  },
  {
    "text": "I swear to come back",
    "start_ind": 5327,
    "end_ind": 5347
  },
  {
    "text": "he gave Rocinante the spur and was soon out of reach",
    "start_ind": 5793,
    "end_ind": 5845
  },
  {
    "text": "he had cleared\nthe wood",
    "start_ind": 5907,
    "end_ind": 5930
  },
  {
    "text": "Come here, my son",
    "start_ind": 5999,
    "end_ind": 6016
  },
  {
    "text": "he\nwill come back",
    "start_ind": 6303,
    "end_ind": 6320
  },
  {
    "text": "gave him leave to go",
    "start_ind": 6822,
    "end_ind": 6842
  },
  {
    "text": "Andres went off",
    "start_ind": 6919,
    "end_ind": 6934
  },
  {
    "text": "he went off",
    "start_ind": 7141,
    "end_ind": 7152
  },
  {
    "text": "he took the road\ntowards his village",
    "start_ind": 7383,
    "end_ind": 7419
  },
  {
    "text": "He now came to a road branching in four directions",
    "start_ind": 8040,
    "end_ind": 8090
  },
  {
    "text": "which road they should take",
    "start_ind": 8191,
    "end_ind": 8218
  },
  {
    "text": "who followed out\nhis first intention",
    "start_ind": 8376,
    "end_ind": 8412
  },
  {
    "text": "to make straight for his own stable",
    "start_ind": 8424,
    "end_ind": 8459
  },
  {
    "text": "he had gone about two miles",
    "start_ind": 8467,
    "end_ind": 8494
  },
  {
    "text": "Toledo traders, on\ntheir way to buy silk at Murcia",
    "start_ind": 8581,
    "end_ind": 8631
  },
  {
    "text": "six of them coming along",
    "start_ind": 8644,
    "end_ind": 8668
  },
  {
    "text": "waiting\nthe approach of these knights-errant",
    "start_ind": 9213,
    "end_ind": 9257
  },
  {
    "text": "they had come near enough",
    "start_ind": 9316,
    "end_ind": 9341
  },
  {
    "text": "The traders halted",
    "start_ind": 9562,
    "end_ind": 9580
  },
  {
    "text": "he charged with levelled lance",
    "start_ind": 11830,
    "end_ind": 11860
  },
  {
    "text": "rolling along the ground for some distance",
    "start_ind": 12100,
    "end_ind": 12142
  },
  {
    "text": "Fly not, cowards and caitiffs",
    "start_ind": 12339,
    "end_ind": 12368
  },
  {
    "text": "coming\nup to him",
    "start_ind": 12675,
    "end_ind": 12691
  },
  {
    "text": "the traders\ncontinued their journey",
    "start_ind": 13363,
    "end_ind": 13398
  }
]