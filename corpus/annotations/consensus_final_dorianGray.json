[
  {
    "text": "He passed out of the room",
    "start_ind": 17,
    "end_ind": 42
  },
  {
    "text": "began the ascent",
    "start_ind": 47,
    "end_ind": 63
  },
  {
    "text": "Basil Hallward\nfollowing close behind",
    "start_ind": 65,
    "end_ind": 102
  },
  {
    "text": "They walked softly",
    "start_ind": 104,
    "end_ind": 122
  },
  {
    "text": "they reached the top landing",
    "start_ind": 270,
    "end_ind": 298
  },
  {
    "text": "went in",
    "start_ind": 706,
    "end_ind": 713
  },
  {
    "text": "A mouse ran scuffling\nbehind the wainscoting",
    "start_ind": 1361,
    "end_ind": 1405
  },
  {
    "text": "the young man, going over to the\nwindow",
    "start_ind": 4407,
    "end_ind": 4446
  },
  {
    "text": "he\nflung himself into the rickety chair",
    "start_ind": 5786,
    "end_ind": 5825
  },
  {
    "text": "He moved slowly towards it",
    "start_ind": 7550,
    "end_ind": 7576
  },
  {
    "text": "passing\nHallward as he did so",
    "start_ind": 7578,
    "end_ind": 7607
  },
  {
    "text": "As soon as he got behind him",
    "start_ind": 7609,
    "end_ind": 7637
  },
  {
    "text": "He rushed at him",
    "start_ind": 7728,
    "end_ind": 7744
  },
  {
    "text": "went out on the landing",
    "start_ind": 8360,
    "end_ind": 8383
  },
  {
    "text": "returned to the room",
    "start_ind": 8578,
    "end_ind": 8598
  },
  {
    "text": "walking\nover to the window",
    "start_ind": 8992,
    "end_ind": 9018
  },
  {
    "text": "stepped out on the balcony",
    "start_ind": 9034,
    "end_ind": 9060
  },
  {
    "text": "policeman going his rounds",
    "start_ind": 9208,
    "end_ind": 9234
  },
  {
    "text": "A woman in a fluttering shawl\nwas creeping slowly by the railings",
    "start_ind": 9391,
    "end_ind": 9456
  },
  {
    "text": "she stopped",
    "start_ind": 9495,
    "end_ind": 9506
  },
  {
    "text": "The policeman strolled over",
    "start_ind": 9567,
    "end_ind": 9594
  },
  {
    "text": "She\nstumbled away",
    "start_ind": 9622,
    "end_ind": 9639
  },
  {
    "text": "went back",
    "start_ind": 9815,
    "end_ind": 9824
  },
  {
    "text": "Having reached the door",
    "start_ind": 9858,
    "end_ind": 9881
  },
  {
    "text": "he turned back",
    "start_ind": 10449,
    "end_ind": 10463
  },
  {
    "text": "he crept quietly downstairs",
    "start_ind": 10662,
    "end_ind": 10689
  },
  {
    "text": "he reached the library",
    "start_ind": 10865,
    "end_ind": 10887
  },
  {
    "text": "Basil Hallward had left\nthe house",
    "start_ind": 11451,
    "end_ind": 11484
  },
  {
    "text": "him come in",
    "start_ind": 11512,
    "end_ind": 11523
  },
  {
    "text": "His valet had gone to bed",
    "start_ind": 11573,
    "end_ind": 11598
  },
  {
    "text": "to Paris that Basil had gone",
    "start_ind": 11622,
    "end_ind": 11650
  },
  {
    "text": "went\nout into the hall",
    "start_ind": 11912,
    "end_ind": 11934
  },
  {
    "text": "slipped out",
    "start_ind": 12166,
    "end_ind": 12177
  },
  {
    "text": "his valet appeared",
    "start_ind": 12275,
    "end_ind": 12293
  },
  {
    "text": "he said, stepping in",
    "start_ind": 12384,
    "end_ind": 12404
  },
  {
    "text": "he went away\nto catch his train",
    "start_ind": 12757,
    "end_ind": 12788
  },
  {
    "text": "The man shambled down the passage",
    "start_ind": 13029,
    "end_ind": 13062
  },
  {
    "text": "passed into the\nlibrary",
    "start_ind": 13135,
    "end_ind": 13158
  },
  {
    "text": "he walked up and down the room",
    "start_ind": 13185,
    "end_ind": 13215
  }
]